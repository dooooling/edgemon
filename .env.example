# EdgeMon Worker Secrets Configuration Example (.dev.vars)

# Master password for admin console login (/admin)
# Generate: openssl rand -base64 32
ADMIN_KEY=<GENERATE_RANDOM_STRONG_KEY>

# Secret for HMAC-SHA256 session cookie signing
# Generate: openssl rand -base64 48
SESSION_SECRET=<GENERATE_RANDOM_STRONG_KEY>

# 256-bit Key for AES-GCM encryption of sensitive database fields (webhook tokens, etc.)
# Generate: openssl rand -hex 32
DATA_ENCRYPTION_KEY=<GENERATE_64_HEX_RANDOM_KEY>

# Optional: Default Global Notification Webhook URL
# WEBHOOK_URL=https://discord.com/api/webhooks/...
