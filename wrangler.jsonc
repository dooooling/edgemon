{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "edgemon",
  "main": "worker/src/index.ts",
  "compatibility_date": "2025-02-14",
  "compatibility_flags": [
    "nodejs_compat"
  ],

  // 直接执行 wrangler deploy 时自动先构建 React 前端
  "build": {
    "command": "pnpm build:web"
  },

  "assets": {
    "directory": "./web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  // 依赖 Wrangler automatic provisioning 自动创建并绑定 D1
  "d1_databases": [
    {
      "binding": "DB"
    }
  ],

  "durable_objects": {
    "bindings": [
      {
        "name": "REALTIME",
        "class_name": "RealtimeHub"
      }
    ]
  },

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "RealtimeHub"
      ]
    }
  ],

  "triggers": {
    "crons": [
      "* * * * *",
      "5 * * * *",
      "30 3 * * *"
    ]
  },

  // 声明生产部署必需的 Secrets，缺失时拒绝部署
  "secrets": {
    "required": [
      "ADMIN_KEY",
      "SESSION_SECRET",
      "DATA_ENCRYPTION_KEY"
    ]
  },

  "observability": {
    "enabled": true
  }
}
